{
  "name": "pulsedeck",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Self-hostable dashboard where AI agents push structured reports.",
  "license": "AGPL-3.0-or-later",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "concurrently -n api,web -c blue,magenta \"pnpm --filter @pulsedeck/api dev\" \"pnpm --filter @pulsedeck/web dev\"",
    "build": "pnpm -r build",
    "test": "pnpm -r --filter=!@pulsedeck/e2e test",
    "test:e2e": "pnpm --filter @pulsedeck/e2e test",
    "lint": "eslint .",
    "typecheck": "pnpm -r typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky"
  },
  "lint-staged": {
    "*": "prettier --write --ignore-unknown"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "concurrently": "^9.1.0",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "globals": "^15.14.0",
    "husky": "9.1.7",
    "lint-staged": "17.0.8",
    "prettier": "^3.4.2",
    "puppeteer-core": "^25.1.0",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.1"
  }
}
