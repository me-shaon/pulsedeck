# ---------------------------------------------------------------------------
# PulseDeck environment configuration
# Copy to `.env` and fill in. Required vars must be set or the API fails fast.
# ---------------------------------------------------------------------------

# --- Required ---
# PostgreSQL connection string (postgres-js / Drizzle).
DATABASE_URL=postgres://pulsedeck:pulsedeck@localhost:5432/pulsedeck
# Secret used to sign auth tokens/sessions. Must be >=32 chars; use a random value.
AUTH_SECRET=change-me-to-a-long-random-secret-string

# --- Optional (defaults shown) ---
# Port the API listens on.
PORT=3001
# Days to retain reports; 0 (default) disables time-based retention (keep
# forever). When >0, an in-process sweep deletes reports whose server
# `created_at` is older than N days. The sweep is guarded by a Postgres advisory
# lock, so with multiple API replicas it runs at most once per interval.
RETENTION_DAYS=0
# How often the retention sweep runs, in milliseconds (default 1h = 3600000).
# Only meaningful when RETENTION_DAYS > 0. Minimum 1000.
RETENTION_SWEEP_INTERVAL_MS=3600000
# Redis connection string. Only needed for the optional realtime profile.
# REDIS_URL=redis://localhost:6379

# Public origin better-auth uses for OAuth callback URLs and origin checks.
# Optional; set this once GitHub login or a cross-origin frontend is in play.
# BETTER_AUTH_URL=http://localhost:3001

# GitHub OAuth credentials. Both must be set to enable the GitHub login option;
# leave empty to disable it (the login screen hides the button via /auth/config).
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

# Bootstrap admin seeded on first boot when there are zero users. Set both to
# skip the /setup wizard headlessly; idempotent (never double-seeds).
# BOOTSTRAP_EMAIL=
# BOOTSTRAP_PASSWORD=
