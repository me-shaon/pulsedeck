{
  "name": "@pulsedeck/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsup src/index.ts --format esm --target node22 --out-dir dist --clean",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.typecheck.json",
    "test": "vitest run",
    "lint": "eslint .",
    "db:generate": "node --import tsx ./node_modules/drizzle-kit/bin.cjs generate",
    "db:migrate": "node --import tsx ./node_modules/drizzle-kit/bin.cjs migrate",
    "db:studio": "node --import tsx ./node_modules/drizzle-kit/bin.cjs studio"
  },
  "dependencies": {
    "@fastify/rate-limit": "^10.0.0",
    "@pulsedeck/schema": "workspace:*",
    "better-auth": "^1.2.7",
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.38.2",
    "fastify": "^5.2.0",
    "ioredis": "^5.4.1",
    "nanoid": "^5.0.9",
    "postgres": "^3.4.5",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "drizzle-kit": "^0.30.1",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^3.0.0"
  }
}
