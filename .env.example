# ---------------------------------------------------------------------------
# PulseDeck environment configuration
# Copy to `.env` and fill in. Required vars must be set or the API fails fast.
# ---------------------------------------------------------------------------

# --- Required ---
# PostgreSQL connection string (postgres-js / Drizzle).
DATABASE_URL=postgres://pulsedeck:pulsedeck@localhost:5432/pulsedeck
# Secret used to sign auth tokens/sessions. Use a long random value in production.
AUTH_SECRET=changeme

# --- Optional (defaults shown) ---
# Port the API listens on.
PORT=3001
# Days to retain reports; 0 disables time-based retention.
RETENTION_DAYS=0
# Redis connection string. Only needed for the optional realtime profile.
# REDIS_URL=redis://localhost:6379

# GitHub OAuth credentials (used by a later phase; leave empty for now).
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

# Bootstrap admin credentials seeded on first boot (used by a later phase).
# BOOTSTRAP_EMAIL=
# BOOTSTRAP_PASSWORD=
