# ---------------------------------------------------------------------------
# PulseDeck environment configuration
# Copy to `.env` and fill in. Required vars must be set or the API fails fast.
# ---------------------------------------------------------------------------

# --- Required ---
#
# Database password for the bundled Postgres. DEV-ONLY value below; the API
# REFUSES TO BOOT with it (or any default like `postgres`/`password`) when
# NODE_ENV=production. The production compose builds the api's DATABASE_URL from
# this single value, so the DB secret lives in exactly one place.
#   PRODUCTION: run `make setup` to generate a strong one (or `openssl rand -hex 24`).
#   ROTATE: change it here, then `docker compose down && docker compose up -d`
#     (Postgres only applies POSTGRES_PASSWORD when initializing an empty volume —
#     to rotate an existing DB, also ALTER USER pulsedeck PASSWORD '…').
POSTGRES_PASSWORD=pulsedeck
#
# PostgreSQL connection string (postgres-js / Drizzle).
#
# LEAVE THIS COMMENTED for the Docker stack (`make dev` / `make up`): Compose
# auto-loads .env, and a SET value here would override the URL each service
# builds from POSTGRES_PASSWORD (host `postgres`) — injecting host `localhost`,
# which inside a container points at the container itself, not the DB. So an
# uncommented localhost URL BREAKS the Docker setup. Commented = each container
# gets the correct `@postgres:5432` URL automatically.
#
# UNCOMMENT it ONLY for:
#   - NON-Docker local dev — run Postgres yourself (or `docker compose up
#     postgres`) and point at host `localhost`:
#       DATABASE_URL=postgres://pulsedeck:pulsedeck@localhost:5432/pulsedeck
#   - an EXTERNAL/managed database in production — set the managed connection
#     string; it overrides the constructed default.
# DATABASE_URL=postgres://pulsedeck:pulsedeck@localhost:5432/pulsedeck
#
# Session/token signing secret (better-auth). Must be >=32 chars.
#
# The value below is a DEV-ONLY placeholder. It is fine for local `make dev`
# (which runs NODE_ENV=development), but the API REFUSES TO BOOT with it when
# NODE_ENV=production — so it can never reach a real deployment by accident.
#
# PRODUCTION: generate a unique secret and put it here (or in your secret store):
#     openssl rand -base64 48
#   …or just run `make setup`, which fills every secret in this file for you.
#
# ROTATE later: replace this value with a freshly generated one and restart the
#   API. Existing sessions are invalidated (users re-login); no data is lost.
AUTH_SECRET=dev-only-insecure-auth-secret-change-for-prod

# --- Docker Compose host ports (only used by `docker compose`) ---
# The host ports the containers publish. Change any that are already taken on
# your machine — e.g. if local Postgres already owns 5432, set POSTGRES_PORT=5544.
# (Containers talk to each other over the internal network regardless of these.)
WEB_PORT=3000
API_PORT=3001
POSTGRES_PORT=5432

# --- Optional API config (defaults shown) ---
# Port the API listens on (inside the container / local dev).
PORT=3001

# --- Deployment profile ---
# `self-host` (default) runs the OSS substrate with permissive defaults:
# first-run /setup wizard, billing off, one implicit account, unlimited limits.
# `cloud` flips the defaults below (public signup, billing on, multi-account,
# per-account retention windows). Each granular flag stays overridable.
# DEPLOYMENT_MODE=self-host
# How new accounts/users may be created: `setup` (first-run wizard only),
# `open` (public self-serve), or `invite` (only via invite token). Default
# derived from DEPLOYMENT_MODE (setup for self-host, open for cloud).
# SIGNUP_MODE=setup
# Whether billing UI/routes are active. Default off for self-host, on for cloud.
# Accepts false/0/no/off (off) or any other value (on).
# BILLING_ENABLED=false
# Days to retain reports; 0 (default) disables time-based retention (keep
# forever). When >0, an in-process sweep deletes reports whose server
# `created_at` is older than N days. The sweep is guarded by a Postgres advisory
# lock, so with multiple API replicas it runs at most once per interval.
RETENTION_DAYS=0
# How often the retention sweep runs, in milliseconds (default 1h = 3600000).
# Only meaningful when RETENTION_DAYS > 0. Minimum 1000.
RETENTION_SWEEP_INTERVAL_MS=3600000
# Redis connection string. Backs the realtime SSE fan-out AND the auth/ingest
# rate-limit store across replicas. Unset → single-node in-memory (both still
# work, just per-process). Required for correct limits when running >1 API node.
# REDIS_URL=redis://localhost:6379

# Per-source ingestion rate limit. INGEST_RATE_LIMIT = max requests per window
# (default 120); INGEST_RATE_WINDOW = window as milliseconds (number) or an
# `ms`-style string like "1 minute" (default 60000).
# INGEST_RATE_LIMIT=120
# INGEST_RATE_WINDOW=60000

# Brute-force throttle for sensitive auth endpoints (sign-in/up, password reset),
# keyed per client IP. AUTH_RATE_LIMIT = max attempts per window (default 20);
# AUTH_RATE_WINDOW = window in ms or an `ms`-style string (default 60000). Raise
# the limit if many users share one external IP (office NAT).
# AUTH_RATE_LIMIT=20
# AUTH_RATE_WINDOW=60000

# Reverse-proxy trust. Behind the bundled nginx set to the number of proxy hops
# (1) so request.ip is the real client — required for the IP-keyed rate limits.
# Accepts true/false, a hop count, or an IP/CIDR. Default off (trust nothing).
# The production compose sets TRUST_PROXY=1 for you.
# TRUST_PROXY=1

# Transactional email (password reset + workspace invites). Leave EMAIL_PROVIDER
# unset for the OSS default: nothing is sent and invite URLs are returned in the
# API response. NOTE: password reset needs real delivery — set EMAIL_PROVIDER=smtp
# plus the SMTP_* vars below to enable it. (Other providers can be added later.)
# EMAIL_PROVIDER=smtp
# EMAIL_FROM="PulseDeck <no-reply@yourdomain.com>"
#
# SMTP transport (used when EMAIL_PROVIDER=smtp). SMTP_HOST is the trigger; the
# rest are optional with sane defaults.
#   SMTP_PORT   = default 587 (STARTTLS). Use 465 with SMTP_SECURE=true.
#   SMTP_SECURE = true for implicit TLS (port 465); false/unset → STARTTLS.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_SECURE=false

# Outbound webhooks. An in-process runner polls a durable queue and POSTs
# matching reports to external URLs (generic JSON / Slack / Discord / Mattermost).
# WEBHOOK_POLL_INTERVAL_MS = how often the runner claims due rows (default 2000).
# WEBHOOK_MAX_ATTEMPTS = per-delivery retry ceiling (default 5).
# WEBHOOK_DELIVERY_TIMEOUT_MS = outbound POST timeout (default 10000).
# WEBHOOK_BATCH_SIZE = rows claimed per poll (default 20).
# WEBHOOK_ALLOW_PRIVATE_IPS = allow URLs that resolve to loopback/private ranges.
#   Defaults true for self-host (internal Slack/services are valid targets) and
#   false for cloud (untrusted multi-tenant input — SSRF defense).
# WEBHOOK_POLL_INTERVAL_MS=2000
# WEBHOOK_MAX_ATTEMPTS=5
# WEBHOOK_DELIVERY_TIMEOUT_MS=10000
# WEBHOOK_BATCH_SIZE=20
# WEBHOOK_ALLOW_PRIVATE_IPS=true

# Public origin the browser uses to reach the app — the WEB origin (nginx serves
# the SPA and proxies /api on the same origin), NOT the API's internal port.
# better-auth uses it for OAuth callback URLs and request-origin validation.
# docker-compose defaults this to http://localhost:3000; override for a custom
# WEB_PORT or a real domain/HTTPS deployment.
# BETTER_AUTH_URL=http://localhost:3000

# GitHub OAuth credentials. Both must be set to enable the GitHub login option;
# leave empty to disable it (the login screen hides the button via /auth/config).
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

# Bootstrap admin seeded on first boot when there are zero users. Set both to
# skip the /setup wizard headlessly; idempotent (never double-seeds).
# BOOTSTRAP_EMAIL=
# BOOTSTRAP_PASSWORD=
